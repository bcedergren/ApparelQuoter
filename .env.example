# Database
MONGODB_URI=mongodb://localhost:27017/apparelquoter

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Provider (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# Application
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3003
JWT_SECRET=<generate-with-openssl-rand-base64-32>

# Mailer API Security (Internal Use Only)
MAILER_API_KEY=<generate-with-openssl-rand-base64-32>

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=public/uploads

# Production Environment Variables
# When deploying to production, use production values:
# - MONGODB_URI should point to MongoDB Atlas or production database
# - NEXTAUTH_URL should be your production domain (https://yourdomain.com)
# - Use Stripe live keys (sk_live_... and pk_live_...)
# - STRIPE_WEBHOOK_SECRET from production webhook endpoint
# - NEXT_PUBLIC_WEBSITE_URL should be production domain

# Generate secrets using:
# openssl rand -base64 32
